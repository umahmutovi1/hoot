# Cloudflare Pages security headers (PRD "Sigurnosno skeniranje", Stage 10b).
# Scripts, styles, fonts (Geist, KaTeX) and workers are all same-origin; Supabase is the only
# backend (REST, Storage signed URLs, Realtime). Inline styles stay allowed for React style props.
# Google Drive Picker (Stage 10c): Google sign-in and Picker scripts and frames, Drive API
# downloads (which may redirect to googleusercontent.com).
# 'wasm-unsafe-eval' (Stage 11a): the FSRS optimizer worker compiles WebAssembly; it allows wasm
# compilation only, not eval of JavaScript.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://apis.google.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.supabase.co; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.googleapis.com https://*.googleusercontent.com https://accounts.google.com/gsi/; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:; frame-src https://docs.google.com https://accounts.google.com https://content.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
