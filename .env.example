# Copy to .env.local (never commit it). Both values are public by design; RLS protects the data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Web Push (VAPID) public key; without it the app offers no notifications (docs/SETUP.md 5b).
VITE_VAPID_PUBLIC_KEY=
